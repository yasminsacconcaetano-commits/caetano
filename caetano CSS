/* Configuração Inicial e Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color: #fff5f7; /* Tom de rosa bem claro/nude */
    color: #333333;
    line-height: 1.6;
}

/* Cabeçalho */
header {
    background-color: #ffffff;
    padding: 20px 10%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 24px;
    font-weight: 700;
    color: #d63384; /* Rosa forte */
    letter-spacing: 1px;
}

nav a {
    text-decoration: none;
    color: #555555;
    margin-left: 25px;
    font-weight: 400;
    transition: 0.3s;
}

nav a:hover {
    color: #d63384;
}

/* Seção Principal (Hero) */
.hero {
    background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('https://images.unsplash.com/photo-1583001931096-959e9a1a6880?auto=format&fit=crop&w=1350&q=80') no-repeat center center/cover;
    height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    padding: 0 20px;
}

.hero h1 {
    font-size: 42px;
    margin-bottom: 15px;
    font-weight: 700;
}

.hero p {
    font-size: 18px;
    margin-bottom: 30px;
    max-width: 600px;
}

/* Botão do WhatsApp */
.btn {
    background-color: #25d366;
    color: white;
    padding: 12px 30px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    transition: 0.3s;
}

.btn:hover {
    background-color: #1ebd5d;
    transform: translateY(-2px);
}

/* Seção de Serviços */
.services {
    padding: 70px 10%;
    text-align: center;
}

.services h2 {
    font-size: 32px;
    color: #d63384;
    margin-bottom: 40px;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
}

.service-card {
    background: white;
    padding: 35px 25px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    transition: 0.3s;
    border-top: 4px solid #d63384;
}

.service-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 8px 20px rgba(214, 51, 132, 0.15);
}

.service-card h3 {
    color: #333333;
    margin-bottom: 15px;
    font-size: 20px;
}

.service-card p {
    color: #666666;
    font-size: 14px;
    margin-bottom: 20px;
}

.price {
    font-weight: 700;
    color: #d63384;
    font-size: 19px;
}

/* Rodapé */
footer {
    background-color: #333333;
    color: white;
    text-align: center;
    padding: 20px;
    font-size: 14px;
}

/* Responsividade para Celulares */
@media (max-width: 768px) {
    .hero h1 {
        font-size: 30px;
    }
    .hero p {
        font-size: 16px;
    }
    nav {
        display: none; /* Esconde o menu simples no mobile para focar na conversão */
    }
}
